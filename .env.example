# ==============================================================================
# Mirach Environment Configuration Template (.env.example)
# Architecture Reference: §17.5 | Rules Reference: §7
# NOTE: Set names only; never commit real secrets or credentials to Git.
# ==============================================================================

# Public Frontend Variables (Vite client-side)
VITE_APP_ENV=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Worker Server Variables (Wrangler non-secret vars)
FIREBASE_PROJECT_ID=
ALLOWED_ORIGIN=
B2_ENDPOINT=
B2_BUCKET=
B2_REGION=
VAPID_PUBLIC_KEY=
LIVEKIT_URL=

# Backend Secrets (Set exclusively via `wrangler secret put <NAME>` by the owner)
# - SESSION_PEPPER
# - B2_KEY_ID
# - B2_APP_KEY
# - VAPID_PRIVATE_KEY
# - LIVEKIT_API_KEY
# - LIVEKIT_API_SECRET
# - FIREBASE_SERVICE_ACCOUNT_JSON (optional)
